<?xml version="1.0" encoding="utf-8"?>
<!--
  Robotiq 2F-85 gripper + Intel RealSense D405 wrist camera end effector.

  robotiq_2f85_d405_kinematics.urdf.xacro is auto-generated by:
    franka_isaacSim/scripts/tooling/extract_gripper_urdf.py
  from the canonical FR3_robotiq_2f85.usd asset.  Run that script inside the
  Isaac Sim container and copy the output here whenever the USD changes.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotiq_2f85_d405">

  <xacro:include
    filename="$(find franka_description)/end_effectors/robotiq_2f85_d405/robotiq_2f85_d405_kinematics.urdf.xacro"/>

  <!--
    Macro: robotiq_2f85_d405
    Params:
      connected_to   — parent link (arm flange, e.g. left_fr3v2_1_link8)
      arm_prefix     — '' | 'left_' | 'right_'  (for dual-arm name isolation)
      robot_type     — fr3v2_1 (default)
      xyz_ee         — translation from link8 to gripper coupling (from USD)
      rpy_ee         — rotation  from link8 to gripper coupling (from USD)
      description_pkg — package containing this file (default: franka_description)
  -->
  <xacro:macro
    name="robotiq_2f85_d405"
    params="connected_to
            arm_prefix:=''
            robot_type:='fr3v2_1'
            xyz_ee:='0 0 0'
            rpy_ee:='0 0 -0.7853982'
            description_pkg:='franka_description'">

    <!--
      Attachment joint: arm flange (link8) → fr3v2_ur_to_robotiq_link.
      rpy_ee default -π/4 comes from the fr3v2_link8/fr3v2_ur_to_robotiq_joint
      in the USD — the UR coupling is rotated −45° about Z relative to the flange.
    -->
    <joint name="${arm_prefix}${robot_type}_ur_to_robotiq_joint" type="fixed">
      <parent link="${connected_to}"/>
      <child  link="${arm_prefix}fr3v2_ur_to_robotiq_link"/>
      <origin xyz="${xyz_ee}" rpy="${rpy_ee}"/>
    </joint>

    <!-- All gripper + camera links and joints (prefixed for dual-arm safety) -->
    <xacro:robotiq_2f85_d405_kinematics arm_prefix="${arm_prefix}" description_pkg="${description_pkg}"/>

  </xacro:macro>

</robot>
